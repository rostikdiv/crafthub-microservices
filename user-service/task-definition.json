{
  "family": "user-service-task-def",
  "executionRoleArn": "arn:aws:iam::437387546814:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::437387546814:role/milhub-ecs-task-role",
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "user-service",
      "image": "437387546814.dkr.ecr.eu-north-1.amazonaws.com/milhub/user-service:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "name": "user-service-8081-tcp",
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "DB_URL",
          "value": "jdbc:postgresql://milhub-user-db.cjuwam6e2uzz.eu-north-1.rds.amazonaws.com:5432/user_service_db"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "aws"
        }
      ],
      "secrets": [
        {
          "name": "DB_PASS",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:437387546814:secret:milhub/rds-password-KVFsjZ"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:437387546814:secret:milhub/rds-username-iluZmg"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:437387546814:secret:milhub/jwt-secret-key-61dM94"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/user-service-task-def",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}