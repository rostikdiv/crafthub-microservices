{
  "family": "api-gateway-task-def",
  "executionRoleArn": "arn:aws:iam::437387546814:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::437387546814:role/milhub-ecs-task-role",
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "437387546814.dkr.ecr.eu-north-1.amazonaws.com/milhub/api-gateway:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "name": "api-gateway-8080-tcp",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "aws"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:437387546814:secret:milhub/jwt-secret-key-61dM94"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/api-gateway-task-def",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}