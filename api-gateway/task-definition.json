{
  "family": "api-gateway-task-definition",
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "437387546814.dkr.ecr.eu-north-1.amazonaws.com/crafthub/api-gateway:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "api-gateway-8080-tcp",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "aws"
        },
        {
          "name": "JWT_SECRET_KEY",
          "value": "bXktc3VwZXItc2VjcmV0LWtleS1mb3ItY3JhZnRodWItbWljcm9zZXJ2aWNlcy1hbmQtZm9yLWp3dC1zaWduYXR1cmUtZ2VuZXJhdGlvbg=="
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/api-gateway-task-definition",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "taskRoleArn": "arn:aws:iam::437387546814:role/crafthub-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::437387546814:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072"
}